// =====================================================
// SUMMARY TABLE PARSER
// Input: Extract from File2 - Summary sheet
// =====================================================

const rows = $input.all().map(item => item.json);


// -----------------------------------------------------
// Helper functions
// -----------------------------------------------------

function get(row, key) {
  const value = row[key];

  if (value === undefined || value === null) {
    return "";
  }

  return String(value).trim();
}


function formatPercent(value) {
  if (value === "") {
    return "";
  }

  const number = Number(value);

  if (!Number.isNaN(number)) {
    return (number * 100).toFixed(2) + "%";
  }

  return String(value);
}


function escapeHTML(value) {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}


// =====================================================
// FIND UNIX / WINDOWS SECTIONS
// =====================================================

const unixIndex = rows.findIndex(row =>
  Object.values(row).some(value =>
    String(value ?? "").toUpperCase().includes("INFUNIX01")
  )
);

const windowsIndex = rows.findIndex(row =>
  Object.values(row).some(value =>
    String(value ?? "").toUpperCase().includes("INFWIN01")
  )
);


if (unixIndex === -1) {
  throw new Error("INFUNIX01 section not found.");
}

if (windowsIndex === -1) {
  throw new Error("INFWIN01 section not found.");
}


const unixRows = rows.slice(unixIndex, windowsIndex);
const windowsRows = rows.slice(windowsIndex);


// =====================================================
// 1. UNIX ENVIRONMENT TABLE
//
// Columns:
// _EMPTY_2  = Environment
// _EMPTY_6  = Nb AccountsNotFound/TotalAccountInInventory
// _EMPTY_12 = Percent
// =====================================================

const unixEnvironment = [];

for (const row of unixRows) {

  const environment = get(row, "_EMPTY_2");
  const accounts = get(row, "_EMPTY_6");
  const pct = get(row, "_EMPTY_12");

  const validEnvironment = [
    "DEV",
    "PRD",
    "STG",
    "UNKNOWN",
    "Total"
  ].includes(environment);

  // IMPORTANT:
  // Require all 3 cells to have values.
  // This removes duplicate rows coming from other tables.

  if (
    validEnvironment &&
    accounts !== "" &&
    pct !== ""
  ) {

    unixEnvironment.push({
      environment: environment,
      accounts: accounts,
      percent: formatPercent(pct)
    });
  }
}


