// Get all rows extracted from the Summary sheet
const rows = $input.all().map(item => item.json);

// Helper to get a cell safely
function cell(row, key) {
  const value = row[key];
  return value === undefined || value === null ? "" : String(value).trim();
}

// Convert decimal percentage to display percentage
function formatPercent(value) {
  if (value === "" || value === null || value === undefined) {
    return "";
  }

  const num = Number(value);

  if (!Number.isNaN(num)) {
    // Excel extraction gives values such as 0.991976...
    return (num * 100).toFixed(2) + "%";
  }

  return String(value);
}

// Escape HTML
function esc(value) {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

// Remove rows that are completely empty for the relevant columns
function validRows(data, columns) {
  return data.filter(row =>
    columns.some(key => cell(row, key) !== "")
  );
}

// Find the rows belonging to the Unix section
const unixStart = rows.findIndex(row =>
  Object.values(row).some(value =>
    String(value ?? "").includes("INFUNIX01")
  )
);

// Find the rows belonging to the Windows section
const windowsStart = rows.findIndex(row =>
  Object.values(row).some(value =>
    String(value ?? "").includes("INFWIN01")
  )
);

if (unixStart === -1 || windowsStart === -1) {
  throw new Error("Could not find INFUNIX01 or INFWIN01 in Summary sheet.");
}

// Unix section ends before Windows section
const unixRows = rows.slice(unixStart, windowsStart);

// Windows section
const windowsRows = rows.slice(windowsStart);

// -----------------------------
// UNIX ENVIRONMENT TABLE
// -----------------------------

const unixEnvRows = validRows(
  unixRows.filter(row => {
    const value = cell(row, "_EMPTY_2");
    return ["DEV", "PRD", "STG", "UNKNOWN", "Total"]
      .includes(value);
  }),
  ["_EMPTY_2", "_EMPTY_6", "_EMPTY_12"]
);

const unixEnvironment = unixEnvRows.map(row => ({
  environment: cell(row, "_EMPTY_2"),
  accounts: cell(row, "_EMPTY_6"),
  percent: formatPercent(cell(row, "_EMPTY_12"))
}));

// -----------------------------
