// =====================================================
// REMOVE ANY DUPLICATES
// =====================================================

function removeDuplicates(array, key) {

  const seen = new Set();

  return array.filter(row => {

    const value = row[key];

    if (seen.has(value)) {
      return false;
    }

    seen.add(value);
    return true;
  });
}


const finalUnixEnvironment =
  removeDuplicates(unixEnvironment, "environment");

const finalUnixArea =
  removeDuplicates(unixArea, "area");

const finalWindowsEnvironment =
  removeDuplicates(windowsEnvironment, "environment");

const finalWindowsArea =
  removeDuplicates(windowsArea, "area");


// =====================================================
// HTML TABLE BUILDER
// =====================================================

function buildTable(title, headers, data, fields) {

  let html = `
    <h3 style="
      font-family: Arial, sans-serif;
      font-size: 15px;
      margin-top: 20px;
      margin-bottom: 8px;
    ">
      ${escapeHTML(title)}
    </h3>

    <table style="
      border-collapse: collapse;
      width: 850px;
      max-width: 100%;
      font-family: Arial, sans-serif;
      font-size: 13px;
      margin-bottom: 20px;
    ">
  `;


  // Header
  html += "<tr>";

  for (const header of headers) {

    html += `
      <th style="
        border: 1px solid #777;
        padding: 7px;
        background-color: #e8e4d5;
        text-align: center;
        font-weight: bold;
      ">
        ${escapeHTML(header)}
      </th>
    `;
  }

  html += "</tr>";


  // Data rows
  for (const row of data) {

    const firstValue =
      String(row[fields[0]]).toLowerCase();

    const isTotal = firstValue === "total";


    html += "<tr>";

    for (const field of fields) {

      html += `
        <td style="
          border: 1px solid #777;
          padding: 6px;
          text-align: center;
          ${isTotal
            ? "font-weight:bold;background-color:#eeeeee;"
            : ""}
        ">
          ${escapeHTML(row[field])}
        </td>
      `;
    }

    html += "</tr>";
  }


  html += `
    </table>
  `;

  return html;
}


