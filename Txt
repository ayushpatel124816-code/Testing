const windowsArea = windowsAreaRows.map(row => ({
  area: cell(row, "_EMPTY_13"),
  accounts: cell(row, "_EMPTY_17"),
  percent: formatPercent(cell(row, "_EMPTY_21"))
}));


// -----------------------------
// HTML TABLE BUILDER
// -----------------------------

function buildTable(title, headers, data, fields) {

  let html = `
    <h3 style="
      font-family: Arial, sans-serif;
      font-size: 15px;
      margin-top: 20px;
      margin-bottom: 8px;
    ">
      ${esc(title)}
    </h3>

    <table style="
      border-collapse: collapse;
      width: 850px;
      max-width: 100%;
      font-family: Arial, sans-serif;
      font-size: 13px;
      margin-bottom: 20px;
    ">
      <tr>
        ${headers.map(header => `
          <th style="
            border: 1px solid #777;
            padding: 7px;
            background-color: #e8e4d5;
            text-align: center;
            font-weight: bold;
          ">
            ${esc(header)}
          </th>
        `).join("")}
      </tr>
  `;

  for (const row of data) {

    const isTotal = String(row[fields[0]]).toLowerCase() === "total";

    html += `
      <tr>
        ${fields.map(field => `
          <td style="
            border: 1px solid #777;
            padding: 6px;
            text-align: center;
            ${isTotal ? "font-weight:bold;background-color:#eeeeee;" : ""}
          ">
            ${esc(row[field])}
          </td>
        `).join("")}
      </tr>
    `;
  }

  html += `</table>`;

  return html;
}


// -----------------------------
// BUILD THE FOUR TABLES
// -----------------------------

const unixEnvHTML = buildTable(
  "Unix Server Native Account distribution based on Environment",
  [
    "AccountInvENV",
    "Nb AccountsNotFound/TotalAccountInInventory",
