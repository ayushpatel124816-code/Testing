function htmlSummaryTable(rows, title, firstColumn) {
  const headerStyle =
    "background-color:#4a7688;color:#fff;font-weight:bold;" +
    "padding:6px;text-align:left;font-family:Arial,sans-serif;" +
    "font-size:12px;border:1px solid #ccc;";

  const cellStyle =
    "padding:5px 8px;font-family:Arial,sans-serif;" +
    "font-size:12px;border:1px solid #ccc;";

  const body = rows.map(row => `
    <tr>
      <td style="${cellStyle}">${escapeHtml(row[firstColumn])}</td>
      <td style="${cellStyle}">${escapeHtml(row.nb)}</td>
      <td style="${cellStyle}">${escapeHtml(row.percent)}</td>
    </tr>
  `).join("");

  return `
    <div style="margin-top:24px;font-family:Arial,sans-serif;">
      <h4 style="margin-bottom:8px;color:#333;">
        ${escapeHtml(title)}
      </h4>
      <table cellpadding="0" cellspacing="0"
        style="border-collapse:collapse;border:1px solid #ccc;">
        <thead>
          <tr>
            <th style="${headerStyle}">${escapeHtml(firstColumn === "env" ? "ENV" : "AREA")}</th>
            <th style="${headerStyle}">Nb AccountsNotFound/TotalAccountInInventory</th>
            <th style="${headerStyle}">%Not onboarded</th>
          </tr>
        </thead>
        <tbody>${body}</tbody>
      </table>
    </div>
  `;
}

