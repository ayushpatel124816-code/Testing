

function escapeHtml(value) {
  if (value === null || value === undefined) return "";
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function toPct(value) {
  if (typeof value === "number") {
    return (value * 100).toFixed(2) + "%";
  }
  return value ?? "";
}

