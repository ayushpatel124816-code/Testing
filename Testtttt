
const latestItems = $("Extract from File").all();
const olderItems1 = $("Extract from File3").all();
const olderItems2 = $("Extract from File4").all();

// Normalize values for reliable comparisons
function normalize(value) {
  if (value === null || value === undefined) return "";
  return String(value).trim().toUpperCase();
}

// Map all source areas into the required KO regions
function normalizeArea(area) {
  const value = normalize(area);

  if (value === "AMER") return "AMER";

  if (["APAC", "ISPL"].includes(value)) {
    return "APAC";
  }

  if (["EMEA", "MEAA", "MIA"].includes(value)) {
    return "EMEA";
  }

  return "UNKNOWN";
}

// Extract Server Name and AREA from an extracted worksheet
function parseSheet(items) {
  const rows = items.map(item => item.json.row || []);

  const headerIndex = rows.findIndex(row =>
    row.some(value =>
      normalize(value) === "SERVER NAME"
    )
  );

  if (headerIndex === -1) {
    throw new Error(
      "SERVER Name header not found in one of the Windows sheets."
    );
  }

  const headers = rows[headerIndex].map(normalize);

  const serverIndex = headers.findIndex(value =>
    value === "SERVER NAME" || value === "SERVERNAME"
  );

  const areaIndex = headers.findIndex(value =>
    value === "AREA"
  );

  if (serverIndex === -1 || areaIndex === -1) {
    throw new Error(
      "SERVER Name or AREA column not found in a Windows sheet."
    );
  }

  const records = [];

  for (let i = headerIndex + 1; i < rows.length; i++) {
    const row = rows[i] || [];
    const server = normalize(row[serverIndex]);

    if (!server) continue;

    // Ignore report-title rows and repeated headers
    if (
      /^INF(?:UNIX|WIN)\d+$/i.test(server) ||
      server === "SERVER NAME" ||
      server === "SERVERNAME"
    ) {
      continue;
    }

    records.push({
      server,
      area: normalizeArea(row[areaIndex])
    });
  }

  return records;
}

// Parse the three Windows sheets
const latest = parseSheet(latestItems);
const older1 = parseSheet(olderItems1);
const older2 = parseSheet(olderItems2);

// Use sets to compare unique server names
const latestServers = new Set(latest.map(r => r.server));
const older1Servers = new Set(older1.map(r => r.server));
const older2Servers = new Set(older2.map(r => r.server));

// Map each server to its latest area
const latestAreaByServer = new Map();

for (const record of latest) {
  if (!latestAreaByServer.has(record.server)) {
    latestAreaByServer.set(record.server, record.area);
  }
}

// Initialize the KO table
const regions = ["AMER", "APAC", "EMEA", "UNKNOWN"];

const counts = {};

for (const region of regions) {
  counts[region] = {
    newAccount: 0,
    oldAccount: 0
  };
}

// Count each unique server in the latest Excel
for (const server of latestServers) {
  const area = latestAreaByServer.get(server) || "UNKNOWN";

  const existsInOlder1 = older1Servers.has(server);
  const existsInOlder2 = older2Servers.has(server);

  if (existsInOlder1 && existsInOlder2) {
    // Old account: present in all three files
    counts[area].oldAccount++;
  } else if (!existsInOlder1 && !existsInOlder2) {
    // New account: present only in the latest file
    counts[area].newAccount++;
  }
  // Servers present in only one older file are excluded
  // from both categories under the current definition.
}

// Build the output table
const output = [];

let totalNew = 0;
let totalOld = 0;

for (const region of regions) {
  const newCount = counts[region].newAccount;
  const oldCount = counts[region].oldAccount;
  const grandTotal = newCount + oldCount;

  totalNew += newCount;
  totalOld += oldCount;

  // Keep zero-count regions visible
  output.push({
    json: {
      "Row Labels": region,
      "New Account": newCount,
      "Old Account": oldCount,
      "Grand Total": grandTotal
    }
  });
}

// Final Grand Total row
output.push({
  json: {
    "Row Labels": "Grand Total",
    "New Account": totalNew,
    "Old Account": totalOld,
    "Grand Total": totalNew + totalOld
  }
});

return output;
